# Template for /opt/taskradar/.env on the VDS -- root:root, mode 0600.
#
# File name: NOT `.env.production.example`, which is what the neighbouring
# CashFlow project uses. This repository's .gitignore ignores `.env.*` and
# re-includes only `.env.example`, so a file called `.env.production.example`
# would be silently untracked and would never reach the server.
#
# Nothing in this file may be copied from the development .env at the repository
# root. Production gets its own PostgreSQL password, its own JWT secret and its
# own password hash; sharing any of them means a leak on the laptop is a leak in
# production, and rotating one forces rotating the other.

# --- Database ------------------------------------------------------------
# Only the Compose project itself talks to this database; the credentials never
# leave the host. Generate the password, do not invent one by hand:
#   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
POSTGRES_DB=taskradar
POSTGRES_USER=taskradar
POSTGRES_PASSWORD=<generate-a-long-random-password>

# --- Auth (single user, no users table) ----------------------------------
# The one and only login email.
AUTH_EMAIL=you@example.com

# bcrypt hash (cost factor 12) of the production password -- never the password
# itself. Generate it in `backend/` on the development machine, where bcrypt is
# already installed:
#
#   node -e "console.log(require('bcrypt').hashSync(process.argv[1], 12))" -- 'PASSWORD'
#
# (passing the password as an argument still lands in the shell history; clear
# it afterwards, or read the password from stdin)
#
# TRAP -- the single quotes below are load-bearing. A bcrypt hash contains `$`,
# and Docker Compose expands `${...}` and `$NAME` inside the values it reads from
# an --env-file. Unquoted, `$2b$12$...` becomes a reference to variables named
# `2b` and `12`, both empty, and the backend receives a truncated string. Single
# quotes disable that expansion (double quotes do not), and bash `source` in the
# deploy script treats them the same way.
#
# If it does go wrong, it fails loudly rather than silently: authConfig.ts checks
# the value against the bcrypt format, so the container refuses to start instead
# of rejecting every login with a 401.
AUTH_PASSWORD_HASH='$2b$12$replace-with-a-real-bcrypt-hash'

# Signing key for session JWTs. Rotating it logs every device out -- that is the
# only kill switch there is, since sessions are not stored anywhere.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<at-least-32-random-characters>

# --- Cookies -------------------------------------------------------------
# `true` in production, always.
#
# The flag is an environment variable rather than a constant because the two
# environments genuinely need opposite values, and both wrong settings fail in a
# confusing way:
#
#   * false behind HTTPS ships a 30-day session cookie that any downgraded or
#     intercepted request may carry in the clear;
#   * true on plain HTTP is worse to diagnose -- the browser accepts the
#     Set-Cookie header and then never sends the cookie back, so auth breaks with
#     no error anywhere.
#
# Only the exact strings "true" and "false" parse. "TRUE", "1" or "yes" make
# validation fail and the container will not start, which is deliberate: an
# unparsable security flag must not quietly default to the weaker value.
#
# The native Android/Windows client sends its token in the Authorization header,
# so it is unaffected either way; the cookie still matters because login sets it
# and the browser frontend (frozen, removed in F6) relies on it.
COOKIE_SECURE=true

# --- Public origin -------------------------------------------------------
# Full HTTPS origin including the port, exactly as the client is built to call
# it. Used by the deploy script to verify the release through the real ingress
# rather than from inside the Compose network.
#
# TODO(owner): fill in once the hostname and ingress port are decided.
APP_ORIGIN=https://<taskradar-host>:<taskradar-ingress-port>

# --- Dictation parsing (F14, optional) ---
# Any OpenAI-compatible /chat/completions endpoint: DeepSeek, OpenRouter, Qwen,
# or a local Ollama / llama.cpp server. Leave all three unset to switch the
# feature off -- dictation then keeps the words exactly as recognised. Setting
# only some of them is refused at startup.
#   DeepSeek:   LLM_BASE_URL="https://api.deepseek.com/v1"   LLM_MODEL="deepseek-chat"
#   OpenRouter: LLM_BASE_URL="https://openrouter.ai/api/v1"  LLM_MODEL="<vendor>/<model>"
#   Ollama:     LLM_BASE_URL="http://<host>:11434/v1"        LLM_MODEL="qwen3:14b"  (no key)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_TIMEOUT_MS=12000
