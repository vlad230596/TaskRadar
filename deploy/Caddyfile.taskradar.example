# TaskRadar site block for the SHARED Caddy instance on the VDS.
#
# Add this as a separate site block to the existing configuration -- it is the
# only file outside /opt/taskradar that TaskRadar touches. Back up the current
# shared Caddyfile and Compose file first, then `caddy validate` the merged
# configuration before recreating Caddy (see DEPLOYMENT.md).
#
# The address is taken from the environment so that this example contains no
# invented domain. Either export TASKRADAR_SITE_ADDRESS for the Caddy container,
# or substitute the literal value while pasting the block in:
#
#     TASKRADAR_SITE_ADDRESS=taskradar.<your-domain>:<your-ingress-port>
#
# TODO(owner): decide the hostname and the ingress port. A port that is already
# taken by another tenant makes Caddy fail to start, which takes every
# application on the host down with it, so check the existing site blocks first.
{$TASKRADAR_SITE_ADDRESS} {
	encode zstd gzip

	header {
		# The client is a native app over HTTPS only; there is no scenario where
		# a downgrade to plain HTTP is wanted. HSTS is host-scoped, not
		# port-scoped: it will apply to every port on this hostname, which is
		# another reason to give TaskRadar its own hostname rather than another
		# port on a hostname shared with a different application.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# Nothing here needs to advertise the proxy.
		-Server

		# Since the web client (F10) this origin does serve a document, so the
		# two headers that only constrain documents are no longer moot. They
		# were deliberately absent while it was an API-only host; that note is
		# kept in DEPLOYMENT.md rather than here.
		#
		# The policy is as tight as a Flutter web bundle allows, and every
		# relaxation below is one the engine genuinely needs:
		#
		#   * 'wasm-unsafe-eval' -- CanvasKit and Skwasm are WebAssembly, and
		#     instantiating a module counts as eval to CSP. It permits Wasm and
		#     nothing else; plain `eval` stays blocked.
		#   * style-src 'unsafe-inline' -- the engine writes inline styles for
		#     the glass pane and for the hidden input it does text editing
		#     through. There is no nonce to give it: those styles are set from
		#     Dart at runtime.
		#   * worker-src blob: -- Skwasm runs its renderer in a worker created
		#     from a Blob URL.
		#
		# `connect-src 'self'` is the load-bearing one: the client's base URL is
		# the page's own origin (see AppConfig), so a bundle that has been
		# tampered with cannot ship the board anywhere else. The build fetches
		# CanvasKit from this origin too -- `flutter build web` is run with
		# `--no-web-resources-cdn`, without which the engine would pull it from
		# gstatic and this line would break the app.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Belt to `frame-ancestors`' braces, for anything that still reads only
		# this one.
		X-Frame-Options "DENY"
	}


	# Fastify's own default body limit is 1 MB; rejecting oversized bodies at the
	# edge keeps them from being buffered by Node at all. Caddy applies
	# directives in its own fixed order regardless of where they appear, but this
	# sits above the handlers so that reading order matches execution order.
	request_body {
		max_size 1MB
	}

	# Explicit allowlist of the API surface, so the only paths that reach Node
	# are the ones the app actually serves. Everything else is refused at the
	# edge without ever touching the backend.
	#
	# TRAP: this list has to be updated when a new top-level route is added to
	# backend/src/routes/. A forgotten prefix looks like a client bug -- 404 from
	# Caddy is indistinguishable from 404 from Fastify -- and it survived a
	# release exactly that way: /scopes (F7) and /inbox (F8) were served by the
	# backend and refused here, so the sandbox answered 404 to every capture from
	# the phone while all of CI was green.
	#
	# So the list is no longer trusted to be maintained by hand:
	# scripts/check-edge-route-coverage.mjs derives the required prefixes from
	# backend/src/routes/ and fails the build when one is missing here or in
	# deploy/Caddyfile.ci. The prefixes are additionally exercised through a real
	# Caddy by .github/workflows/integration-ci.yml.
	#
	# Neither check can see the file that actually serves traffic: this one is
	# pasted into the shared Caddyfile on the VDS by hand, so a fix here is not
	# live until that is done (DEPLOYMENT.md).
	@api path /health /ready /version /auth/* /board /scopes /scopes/* /projects /projects/* /tasks/* /notes/* /inbox /inbox/*
	handle @api {
		# Matches the alias and port from compose.prod.yaml. Resolution works only
		# because the Caddy container is attached to the `taskradar-ingress`
		# network.
		reverse_proxy taskradar-backend:3001
	}

	# Everything else is the web client (F10): the `flutter build web` bundle,
	# served by the `taskradar-web` container from compose.prod.yaml over the
	# same `taskradar-ingress` network as the backend.
	#
	# Not a `file_server` here, and that is the isolation model rather than a
	# preference: this Caddy belongs to another tenant, and pointing it at a
	# directory would mean mounting TaskRadar's filesystem into a container
	# shared by four applications. A second upstream costs one line and keeps
	# the only shared thing a network hop.
	#
	# `handle` blocks are mutually exclusive, so a request that matched `@api`
	# never reaches this one; the unmatched rest lands here. That this really is
	# the resulting order -- rather than something the Caddyfile adapter chose --
	# is not taken on trust: deploy/Caddyfile.ci carries the same two blocks and
	# .github/workflows/integration-ci.yml asserts through a real Caddy that
	# /board still answers 401 from the backend while / answers the bundle.
	#
	# The bundle's own server answers 404 for anything that is not a file it
	# holds: there is no SPA fallback, because Flutter keeps its routes in the
	# URL fragment. See deploy/web/nginx.conf for why that matters here.
	handle {
		reverse_proxy taskradar-web:8080
	}
}
