// TaskRadar — Prisma schema (Iteration 1: data model + REST API)
//
// IMPORTANT: DATABASE_URL lives in exactly one place — the repo-root `.env`
// (one directory above `backend/`). The Prisma CLI only auto-loads a `.env`
// sitting next to this file, so every npm script that shells out to `prisma`
// wraps the call with `dotenv-cli` pointed at `../.env` (see backend/package.json,
// scripts prefixed `prisma:*`). Do not add a `backend/.env` or
// `backend/prisma/.env` — that would create a second source of truth for the
// secret connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  pending
  done
  blocked
}

model Scope {
  id   String @id @default(cuid())
  name String
  // Ordering key across scopes: the same gapped-float scheme as Task.position,
  // for the same reasons (see src/domain/position.ts). Scopes are few -- a
  // handful per person -- so the argument about avoiding O(n) renumbering
  // matters less here than it does for tasks; reusing the scheme is about
  // having one ordering mechanism in this codebase rather than two that behave
  // subtly differently when something is dragged.
  position Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@index([position])
  @@map("scopes")
}

model Project {
  id      String @id @default(cuid())
  name    String
  // Which space this project belongs to (F7). Required rather than nullable: a
  // project with no scope would be invisible on a board that always shows
  // exactly one scope -- "where did my project go" -- so the migration creates
  // a default scope and puts every existing project in it.
  scopeId String
  // `Restrict`, not `Cascade`: deleting a scope must never take its projects
  // (and their tasks and notes) with it. The route refuses a non-empty scope
  // with a 409 long before this matters; the constraint is what makes that
  // impossible rather than merely unlikely.
  scope   Scope  @relation(fields: [scopeId], references: [id], onDelete: Restrict)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tasks Task[]
  notes Note[]

  @@index([scopeId])
  @@map("projects")
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(pending)
  // Ordering key within a project. Float with large gaps between siblings so
  // that moving one task between two neighbours only ever requires writing
  // that single row (new position = average of the two neighbours' positions)
  // instead of renumbering every task in the project. See
  // src/domain/position.ts for the full rationale and the rebalance fallback
  // used when the gap between two neighbours is exhausted.
  position Float
  remindAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, position])
  @@map("tasks")
}

/// The sandbox (F8): a line of text written down before deciding where it
/// belongs.
///
/// A table of its own rather than a Task with a nullable projectId, or a
/// reserved "Inbox" project. Both of those were the obvious candidates and both
/// cost more than this one:
///
/// - a reserved project makes the inbox a Project everywhere -- it would need a
///   guard in the board query, the archive, the delete guard, rename, notes and
///   `isCurrent` (a pile has no "current task"), and with scopes it would have
///   to live in one, which contradicts the whole point of capturing something
///   before deciding which part of life it belongs to;
/// - a nullable `Task.projectId` touches every task route, `isCurrent`,
///   `position`, the board and the client's cache.
///
/// This touches nothing that already exists. It is also the honest shape: an
/// item here has no status, no order and no reminder date, because it is not
/// yet work -- it is a note to self that becomes a Task the moment it is filed
/// into a project.
model InboxItem {
  id   String @id @default(cuid())
  text String

  /// Idempotency key for offline capture (F8.1), generated by the client.
  ///
  /// A phone that captured a line with no signal replays the request when the
  /// signal comes back, and "replay" includes the case where the first attempt
  /// *did* reach the server and only the answer was lost. Without a key the
  /// user gets two identical lines in the pile and no way to tell which one is
  /// the ghost, so the client stamps each captured line with a key it keeps in
  /// its own queue and `POST /inbox` upserts on it.
  ///
  /// Nullable because it is the client's to provide: a line typed at a desk in
  /// the browser (or by curl) has no queue behind it and needs no key, and
  /// Postgres treats every NULL in a unique index as distinct, so those rows do
  /// not collide with each other.
  captureKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("inbox_items")
}

model Note {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("notes")
}
