// TaskRadar — Prisma schema (Iteration 1: data model + REST API)
//
// IMPORTANT: DATABASE_URL lives in exactly one place — the repo-root `.env`
// (one directory above `backend/`). The Prisma CLI only auto-loads a `.env`
// sitting next to this file, so every npm script that shells out to `prisma`
// wraps the call with `dotenv-cli` pointed at `../.env` (see backend/package.json,
// scripts prefixed `prisma:*`). Do not add a `backend/.env` or
// `backend/prisma/.env` — that would create a second source of truth for the
// secret connection string.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  pending
  done
  blocked
}

/// What a row in the task journal records (F11).
///
/// Four kinds and no more, because each one answers a question the three modes
/// ask and `tasks` alone cannot:
///
/// - `created` — when the clock started. Also carries the initial status in
///   `toStatus`, so replaying a task's journal never has to consult the task
///   row to know where the first interval began;
/// - `status` — the only thing that moves a task between states, and therefore
///   the only thing that can say how long it sat in each one;
/// - `focused` / `unfocused` — when it entered and left the working set. That
///   is a different question from "was it pending": a task can wait for weeks
///   in the queue and be worked on in one afternoon.
///
/// Edits to the title, the description or the reminder date are deliberately
/// *not* here. They are not movement — nothing in planning, work or history
/// changes because a wording was corrected — and recording them would turn a
/// journal that is read on every history screen into an edit log nobody asks a
/// question of.
///
/// `reopened` (design/today-history-contract.md): «Вернуть» on a closed task --
/// `fromStatus` done, `toStatus` the status it had before the closing. Its own
/// kind rather than a plain `status` row, because the journal in the editor
/// says «возвращена», and because the closing it undoes is marked
/// (`TaskEvent.revokedAt`) rather than left to be counted.
enum TaskEventKind {
  created
  status
  focused
  unfocused
  reopened
}

/// A person who can log in (multi-user).
///
/// Data is separated by owner, not shared: every tree of rows hangs off exactly
/// one user through its root -- `Scope` (and through it projects, tasks, notes
/// and the task journal), `InboxItem` and `DictationParse`. Only the roots carry
/// `userId` (`Contour` and `Goal` are roots too: a goal links tasks from many
/// projects, so it cannot hang off any one of them); everything below them is
/// reached through its parent, so there is
/// one column per tree to filter on rather than a copy of it on every table.
///
/// There is no registration. Users are created by an operator with
/// `npm run user:create`. The very first user has the fixed id `owner`: that is
/// the `sub` every token issued before this table existed already carries, so the
/// migration that creates it keeps those sessions and that data attached to
/// whoever was the only user.
model User {
  id           String    @id @default(cuid())
  /// Trimmed, lowercase (see `normaliseEmail`).
  email        String    @unique
  name         String
  passwordHash String
  /// Set instead of deleting: a disabled user cannot log in and their live
  /// tokens stop working, but their data stays until someone removes it by hand.
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())

  /// The contour the owner switched to by hand (design/goals-ideas-contract.md),
  /// and until when that choice beats the contours' schedules. Both null: no
  /// manual choice, the schedules decide. `until` null with a contour set:
  /// until the next manual switch.
  ///
  /// Stored, not resolved: which contour is active *now* depends on the
  /// device's wall clock and time zone, which the server does not know at the
  /// moment of a request -- the app runs `resolveActiveContour` itself. This
  /// row only carries the override across the owner's devices, so switching
  /// on the desktop switches the phone too.
  ///
  /// `SetNull`: deleting the chosen contour simply ends the override.
  activeContourId    String?
  activeContour      Contour?  @relation("UserActiveContour", fields: [activeContourId], references: [id], onDelete: SetNull)
  activeContourUntil DateTime?

  /// The owner's settings that every device shares
  /// (design/today-history-contract.md), bounded by CHECK constraints in the
  /// migration (20261127090000_today_history_review):
  ///
  /// - `laterHorizonDays` (1..90): a task dated further out than today plus
  ///   this many days is «Позже» -- folded at the bottom of its project, and
  ///   skipped when the current task and a goal's next step are chosen;
  /// - `reviewWeekday` (1 = Monday .. 7) and `reviewTime` ("HH:MM", the
  ///   owner's wall clock): when the weekly review falls due.
  laterHorizonDays Int    @default(10)
  reviewWeekday    Int    @default(1)
  reviewTime       String @default("09:00")

  scopes          Scope[]
  inboxItems      InboxItem[]
  dictationParses DictationParse[]
  aiUsage         AiUsage[]
  agentTokens     AgentToken[]
  contours        Contour[]        @relation("UserContours")
  goals           Goal[]
  reviews         Review[]

  @@map("users")
}

/// A set of goal slots that is in force at some times and not others --
/// "Работа" on weekdays from nine to six, "Личное" the rest of the time
/// (design/goals-ideas-contract.md).
///
/// WHY CONTOURS AND NOT SCOPES
///
/// A scope partitions the *board* -- which projects are on screen. A contour
/// partitions *attention* -- which few results the owner is pushing this week.
/// The two look alike and are not: a personal goal ("сделать загранпаспорт")
/// can need a task from the "work" scope (a certificate from HR), and a work
/// goal can be blocked by something at home. Tying goals to scopes would force
/// every goal into one part of life; so contours stand on their own and a goal
/// links tasks from any project of its owner.
///
/// Every user has at least one: the migration that created this table gave
/// every existing user «Основной», user creation does the same for new ones,
/// and `DELETE /contours/:id` refuses the last one. The first one by
/// `position` is the default -- where a task taken into work without saying
/// which contour goes.
///
/// `slots` and `windowDays` are bounded by CHECK constraints in the migration
/// (20261124090000_add_goals_contours), like the task's place.
model Contour {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation("UserContours", fields: [userId], references: [id], onDelete: Cascade)
  name       String
  /// How many goals may stand in this contour's slots at once, 1..5. Enforced
  /// when a goal is put into a slot (409 `slots_full`); lowering it below the
  /// number already there is allowed -- the surplus stays and the app shows it.
  slots      Int    @default(2)
  /// A goal's window when it has none of its own, 1..90 days.
  windowDays Int    @default(7)
  /// When this contour is in force: null (no schedule) or
  /// `{ "days": [1..7], "from": "HH:MM", "to": "HH:MM" }`, 1 = Monday, the
  /// owner's local wall clock. Validated by `contourScheduleSchema`.
  schedule   Json?
  /// Gapped-float order (src/domain/position.ts); the first is the default.
  position   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals        Goal[]
  focusedTasks Task[]
  activeFor    User[]      @relation("UserActiveContour")
  taskEvents   TaskEvent[]

  @@index([userId, position])
  @@map("contours")
}

/// A result worth pushing for a limited time (design/goals-ideas-contract.md):
/// "сдать отчёт", "починить отопление на даче".
///
/// The problem it answers is that tasks get picked by how pleasant and how
/// fresh they are, not by how useful: the useful-but-unpleasant one is never
/// on screen. A goal sits in one of its contour's few slots for a window (a
/// week, say), carries a "why", and its next step is put in front of the owner
/// on the work screen and in the widget.
///
/// The state is derived, never stored, so there is no column that can
/// disagree with the timestamps (src/domain/goals.ts):
///
/// - achieved -- `achievedAt` set;
/// - slot     -- `slottedAt` set (and not achieved);
/// - bench    -- neither.
///
/// An expired window does nothing by itself: the goal stays in its slot, and
/// the app asks "продлить / на скамейку / достигнута". Moving it anywhere
/// without the owner would be the app deciding what matters.
model Goal {
  id           String    @id @default(cuid())
  /// Owner. `Cascade` like the contour: a goal is a note-to-self about
  /// priorities, not data anybody else's rows depend on.
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `Restrict`: a contour with goals -- achieved ones included, they are the
  /// history -- cannot be deleted; `DELETE /contours/:id` answers 409 first.
  contourId    String
  contour      Contour   @relation(fields: [contourId], references: [id], onDelete: Restrict)
  title        String
  /// "Зачем" / "что будет, если отложить" -- one line, at most 300 characters.
  why          String?
  slottedAt    DateTime?
  /// The goal's own window in days, or null for its contour's.
  windowDays   Int?
  /// End of the current window; set when the goal is slotted or extended,
  /// cleared when it leaves the slot.
  windowEndsAt DateTime?
  /// Set only by hand ("достигнута"); nothing closes a goal automatically.
  achievedAt   DateTime?
  /// Order within the contour -- slots and bench are one order, so a goal
  /// taken off the bench comes back to where it was.
  position     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks GoalTask[]
  ideas GoalIdea[]

  @@index([userId, contourId, position])
  @@index([contourId])
  @@map("goals")
}

/// A task that serves a goal. Many-to-many: one task can move two goals
/// forward (a trip to the city for documents *and* for parts), and those goals
/// can be in different contours. Tasks may come from any of the owner's
/// projects -- that is the point of a goal crossing project lines.
///
/// `position` orders the goal's tasks (src/domain/position.ts); the first
/// pending one is the goal's next step. It belongs to the link, not the task,
/// because the same task can be first for one goal and last for another.
model GoalTask {
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  position  Float
  createdAt DateTime @default(now())

  @@id([goalId, taskId])
  @@index([taskId])
  @@map("goal_tasks")
}

/// An idea (a note) kept next to a goal: something that may become one of its
/// tasks. When the idea is turned into a task (`POST /notes/:id/to-task`) the
/// link moves over to `GoalTask`.
model GoalIdea {
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([goalId, noteId])
  @@index([noteId])
  @@map("goal_ideas")
}

/// A personal API token for coding agents: the MCP endpoint (`POST /mcp`).
///
/// Only the SHA-256 of the token is stored. The plain value is shown once, in
/// the answer to `POST /agent-tokens`, and cannot be recovered afterwards. A
/// plain hash rather than bcrypt because the token is 256 random bits -- there
/// is nothing to brute-force, and the lookup has to be one indexed equality.
///
/// The scope is the MCP endpoint and nothing else: the session guard knows
/// nothing about these tokens, so one sent to `/board` is just a bad JWT (401).
///
/// Revoked rather than deleted: a revoked token never authenticates again and
/// leaves the list, but the row stays as a record that it existed.
/// One weekly review, as it was finished (design/today-history-contract.md):
/// the period it covered and the numbers of that period, frozen. The row of
/// these is the «путемер» on the «Недели» tab.
///
/// Numbers are stored rather than recomputed on read: a task deleted or moved
/// to another project later must not rewrite what the owner saw and wrote a
/// summary about. The review itself acts through the ordinary routes (tasks,
/// focus, goals, projects); this row only records the result.
///
/// `periodStart` is the previous review's `periodEnd` (or a week before this
/// one's for the first), so consecutive reviews tile time with no gaps:
/// a skipped week is simply covered by the next review. `summary` is at most
/// 300 characters (a CHECK in 20261127090000_today_history_review).
model Review {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  /// The first review in a new calendar month (by the local date of
  /// `periodEnd`): it also showed the past month.
  monthly       Boolean  @default(false)
  closedCount   Int
  /// `[{ projectId, name, closed }]`, most closed first.
  byProject     Json
  /// `[{ goalId, title }]`: goals achieved within the period.
  achievedGoals Json
  summary       String?
  createdAt     DateTime @default(now())

  @@index([userId, periodEnd])
  @@map("reviews")
}

model AgentToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What the owner called it ("ноутбук", "Claude Code"). Optional.
  name       String?
  /// Hex SHA-256 of the whole token.
  tokenHash  String    @unique
  /// The first characters of the token, to tell tokens apart in the list.
  prefix     String
  createdAt  DateTime  @default(now())
  /// Refreshed at most once a minute while the token is in use.
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId, createdAt])
  @@map("agent_tokens")
}

/// How many AI requests a user has made on one UTC day, for the daily limit.
/// `day` is `YYYY-MM-DD`. Rows older than a day are dead weight, never read.
model AiUsage {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    String
  count  Int    @default(0)

  @@id([userId, day])
  @@map("ai_usage")
}

model Scope {
  id       String @id @default(cuid())
  /// Owner. `Restrict`: removing a user must never silently take their data.
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  name     String
  // Ordering key across scopes: the same gapped-float scheme as Task.position,
  // for the same reasons (see src/domain/position.ts). Scopes are few -- a
  // handful per person -- so the argument about avoiding O(n) renumbering
  // matters less here than it does for tasks; reusing the scheme is about
  // having one ordering mechanism in this codebase rather than two that behave
  // subtly differently when something is dragged.
  position Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@index([userId, position])
  @@map("scopes")
}

model Project {
  id      String @id @default(cuid())
  name    String
  // Which space this project belongs to (F7). Required rather than nullable: a
  // project with no scope would be invisible on a board that always shows
  // exactly one scope -- "where did my project go" -- so the migration creates
  // a default scope and puts every existing project in it.
  scopeId String
  // `Restrict`, not `Cascade`: deleting a scope must never take its projects
  // (and their tasks and notes) with it. The route refuses a non-empty scope
  // with a 409 long before this matters; the constraint is what makes that
  // impossible rather than merely unlikely.
  scope   Scope  @relation(fields: [scopeId], references: [id], onDelete: Restrict)

  archivedAt DateTime?

  /// The project's rhythm (design/today-history-contract.md), opt-in: a norm
  /// of closings per week (1..50), compared with the average of the last two
  /// weeks, and a ceiling of open tasks (1..500). Both null: no rhythm. The
  /// signal itself is computed, never stored -- src/domain/rhythm.ts.
  rhythmClosedPerWeek Int?
  rhythmMaxOpen       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks      Task[]
  notes      Note[]
  categories TaskCategory[]

  @@index([scopeId])
  @@map("projects")
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(pending)
  // Ordering key within a project. Float with large gaps between siblings so
  // that moving one task between two neighbours only ever requires writing
  // that single row (new position = average of the two neighbours' positions)
  // instead of renumbering every task in the project. See
  // src/domain/position.ts for the full rationale and the rebalance fallback
  // used when the gap between two neighbours is exhausted.
  position    Float
  remindAt    DateTime?
  /// The time of day of the reminder, local wall clock "HH:MM", or null for
  /// "the day only" (the app then fires it at the hour from its settings).
  /// Kept apart from `remindAt` rather than folded into it: `remindAt` is a
  /// calendar date stored as UTC midnight and every reader takes its
  /// `YYYY-MM-DD` prefix, which a real instant would break east of UTC.
  /// Meaningless without `remindAt`; the routes clear both together.
  remindTime  String?

  /// The group the task is drawn in on the project screen, or null for "без
  /// категории". One at most, by choice: a task in two groups would be drawn
  /// twice, and the list is a list of what is left to do, not an index.
  /// `SetNull`: deleting a category ungroups its tasks, never deletes them.
  categoryId String?
  category   TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// When this task was put into the working set -- the 2-5 tasks the "work"
  /// mode shows one at a time (F11). `null` means it is not in the set.
  ///
  /// A timestamp rather than a boolean, because the set is ordered and the
  /// order that makes sense is the order things were picked: the set is
  /// assembled at a desk and worked through from a phone, so the phone must
  /// show it in the sequence it was built in, not in whatever order the rows
  /// come back.
  ///
  /// It lives on the task rather than in a table of its own for the same
  /// reason there is no "today" list in this product (README): the set is one
  /// person's answer to "what am I doing now", there is exactly one of it, and
  /// a join table would be machinery for a many-to-many that cannot happen.
  ///
  /// The "no more than five" rule is NOT enforced here or anywhere on the
  /// server. It is a property of the screen -- five slots is what fits and what
  /// a person can hold -- and the server has no way to know why five. See
  /// src/routes/focus.ts.
  focusedAt DateTime?

  /// Whose working set the task is in (design/goals-ideas-contract.md): each
  /// contour has its own, so "Работа" and "Личное" do not crowd one screen.
  /// Set together with `focusedAt` and cleared with it; moving a task to
  /// another contour's set changes only this, not `focusedAt` -- the order of
  /// the set is when the task was picked, and switching sets is not picking.
  /// `SetNull` is a backstop: `DELETE /contours/:id` moves the tasks to the
  /// default contour before the row goes.
  focusContourId String?
  focusContour   Contour? @relation(fields: [focusContourId], references: [id], onDelete: SetNull)

  /// When the task was closed (design/today-history-contract.md): set on the
  /// way into `done`, cleared on the way out. Because leaving `done` also
  /// revokes the closing in the journal (`TaskEvent.revokedAt`), a task's
  /// `doneAt` is exactly its one closing that still counts -- so «Сделано»,
  /// the week bars, the rhythm and the review all count closings from here,
  /// and the list and the numbers cannot disagree.
  doneAt DateTime?

  /// What AI processing started from (see src/domain/aiMark.ts): the words
  /// before the FIRST "Обработать", the kind of that first parse, and a
  /// snapshot of the fields as the last AI answer saved them -- the app
  /// compares it with the row to say "изменён после AI". All null when AI
  /// never touched it, or after "вернуть исходник".
  aiSource String?
  aiKind   String?
  aiResult Json?

  /// Idempotency key of a task created from the phone's offline outbox: the
  /// client stamps a queued create with it, and `POST /projects/:id/tasks`
  /// answers a replay with the task it already made instead of a twin -- the
  /// same design as `InboxItem.captureKey`, see there and src/routes/tasks.ts.
  /// Null for every task created without one (Postgres treats NULLs in a
  /// unique index as distinct).
  createKey String?

  /// Чек-лист (task editor, design/task-editor-spec.md §6, §10): an array of
  /// `{ id, text, done }`, or null for "no list" -- `[]` is stored as null.
  /// JSON rather than a table: nobody asks for one item on its own, and the
  /// whole list goes through `PATCH /tasks/:id` with `expected`, so an offline
  /// conflict is about the list as a whole -- enough for a personal tracker.
  /// Validated by `checklistSchema` in src/schemas.ts.
  checklist Json?

  /// "Напомнить по месту" (§7): all four or none -- a CHECK constraint in the
  /// migration (20261111100000_task_checklist_location_attachments) holds the
  /// database to it. Outside the database the four are one `location` object,
  /// see src/domain/taskView.ts.
  locLat    Float?
  locLng    Float?
  /// Metres, 100..1000.
  locRadius Int?
  /// At most 80 characters.
  locLabel  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events TaskEvent[]

  /// Pictures (§6, §10). Only metadata lives here; the files are on the
  /// attachments volume, see src/domain/attachmentStore.ts.
  attachments TaskAttachment[]

  /// The dictation parses this task was created from (F14) -- normally one.
  dictationParses DictationParse[]

  /// The goals this task serves; achieved ones are filtered out when shown.
  goalLinks GoalTask[]

  @@index([projectId, position])
  @@index([categoryId])
  @@index([focusContourId])
  @@index([doneAt])
  // Per project, which is per user: a task has no userId of its own, a project
  // belongs to exactly one user, and a task changes project only within one
  // user's projects (`POST /tasks/:id/move`, which clears the key). So this
  // scopes a key to its owner the way `@@unique([userId, captureKey])` does on
  // the inbox, without denormalising userId onto every task -- and a key that
  // two people's phones happened to share can neither collide nor answer one
  // user's replay with the other's task. (A replay always names the project of
  // the original request: it is the same request, sent again.)
  @@unique([projectId, createKey])
  @@map("tasks")
}

/// A group of tasks inside one project -- "Кухня", "Документы", "Закупки".
///
/// Per project rather than global or per scope: what groups the tasks of a
/// renovation has nothing to do with what groups the tasks of a job search, and
/// a shared list would fill every project's picker with the others' words.
///
/// Grouping only. It changes neither the order of the project's tasks (one
/// `Task.position` per project, as before) nor which one is current
/// (`isCurrent` is still the first open task of the whole project): a group is
/// a slice of the list, not a list of its own.
model TaskCategory {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  /// Order of the groups on the screen: the same gapped-float scheme as
  /// `Task.position` (see src/domain/position.ts). New ones go last.
  position  Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([projectId, position])
  @@map("task_categories")
}

/// One row per thing that happened to a task (F11).
///
/// WHY A JOURNAL AT ALL
///
/// `createdAt` and `updatedAt` answer "how old" and "when was it last touched",
/// and those two are what the planning mode needs. The history mode asks
/// questions they cannot answer: how long did this hang in `blocked`, what did
/// I actually close last week, is this project moving or only growing. Those
/// need the transitions themselves, and a row that is overwritten in place does
/// not have them -- the moment a task goes `blocked -> pending`, the fact that
/// it was blocked for eleven days is gone forever.
///
/// WRITTEN IN THE SAME TRANSACTION AS THE CHANGE IT DESCRIBES
///
/// Every route that moves a task wraps the task write and the event write in
/// one `prisma.$transaction` (see src/routes/tasks.ts and src/routes/focus.ts).
/// A journal appended by a second query after the first one succeeded starts
/// lying at the first error, and it lies in the worst possible direction: the
/// task shows a state nothing in the journal explains, so the history screen
/// draws a shape that never happened and there is no way to tell which of the
/// two is wrong.
///
/// DELETING A TASK DELETES ITS EVENTS (`Cascade`)
///
/// This is the task's own history, not an audit trail: nobody is accountable to
/// anyone here (README: an instrument for one person, not a team). Events that
/// outlived their task would be rows nothing can render -- the history screen
/// shows titles and project names -- and keeping them would quietly turn a
/// personal tool into a thing that remembers what you deleted.
model TaskEvent {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  kind TaskEventKind

  /// The transition, for `kind = status`. Both are nullable because the other
  /// three kinds have no status to report: `created` fills only `toStatus` (the
  /// status the task started in, so a replay can begin without reading the task
  /// row), and focus events fill neither -- entering the working set is not a
  /// change of status, and a task can be picked up while `blocked` and stay
  /// blocked.
  fromStatus TaskStatus?
  toStatus   TaskStatus?

  at DateTime @default(now())

  /// `focused` / `unfocused`: whose working set the task entered or left
  /// (design/today-history-contract.md) -- what «Вернуть» reads to put a
  /// closed task back into the set it was taken out of. Null on rows from
  /// before the column, and on a task that was in no contour's set (the
  /// default contour's, then). `SetNull`: a deleted contour sends «Вернуть»
  /// to the default one.
  contourId String?
  contour   Contour? @relation(fields: [contourId], references: [id], onDelete: SetNull)

  /// On a `status` -> done row: when that closing was undone. Any way out of
  /// `done` -- «Вернуть» or a plain status change -- revokes the task's last
  /// closing that still counts: closed and changed one's mind is not a
  /// closing. A revoked closing is counted nowhere.
  revokedAt DateTime?

  /// The one access pattern that matters: a single task's journal, in order --
  /// both for the "life of this task" section and for replaying how long it
  /// spent in each status. The history aggregates scan by `at` across all
  /// tasks instead, without an index of their own: the journal of a personal
  /// tracker is thousands of rows at the outside, and an index that is never
  /// the difference between fast and slow is a write cost paid for nothing.
  @@index([taskId, at])
  @@map("task_events")
}

/// The sandbox (F8): a line of text written down before deciding where it
/// belongs.
///
/// A table of its own rather than a Task with a nullable projectId, or a
/// reserved "Inbox" project. Both of those were the obvious candidates and both
/// cost more than this one:
///
/// - a reserved project makes the inbox a Project everywhere -- it would need a
///   guard in the board query, the archive, the delete guard, rename, notes and
///   `isCurrent` (a pile has no "current task"), and with scopes it would have
///   to live in one, which contradicts the whole point of capturing something
///   before deciding which part of life it belongs to;
/// - a nullable `Task.projectId` touches every task route, `isCurrent`,
///   `position`, the board and the client's cache.
///
/// This touches nothing that already exists. It is also the honest shape: an
/// item here has no status, no order and no reminder date, because it is not
/// yet work -- it is a note to self that becomes a Task the moment it is filed
/// into a project.
model InboxItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  text   String

  /// Idempotency key for offline capture (F8.1), generated by the client.
  ///
  /// A phone that captured a line with no signal replays the request when the
  /// signal comes back, and "replay" includes the case where the first attempt
  /// *did* reach the server and only the answer was lost. Without a key the
  /// user gets two identical lines in the pile and no way to tell which one is
  /// the ghost, so the client stamps each captured line with a key it keeps in
  /// its own queue and `POST /inbox` upserts on it.
  ///
  /// Nullable because it is the client's to provide: a line typed at a desk in
  /// the browser (or by curl) has no queue behind it and needs no key, and
  /// Postgres treats every NULL in a unique index as distinct, so those rows do
  /// not collide with each other.
  captureKey String?

  /// What AI processing started from (see src/domain/aiMark.ts): the words
  /// before the FIRST "Обработать", the kind of that first parse, and a
  /// snapshot of the fields as the last AI answer saved them -- the app
  /// compares it with the row to say "изменён после AI". All null when AI
  /// never touched it, or after "вернуть исходник".
  aiSource String?
  aiKind   String?
  aiResult Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dictationParses DictationParse[]

  // Per user: two people's phones may well generate the same key.
  @@unique([userId, captureKey])
  @@index([userId, createdAt])
  @@map("inbox_items")
}

model Note {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String   @default("")
  /// What AI processing started from (see src/domain/aiMark.ts): the words
  /// before the FIRST "Обработать", the kind of that first parse, and a
  /// snapshot of the fields as the last AI answer saved them -- the app
  /// compares it with the row to say "изменён после AI". All null when AI
  /// never touched it, or after "вернуть исходник".
  aiSource String?
  aiKind   String?
  aiResult Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dictationParses DictationParse[]

  /// Goals this idea is kept next to. Called "идея" everywhere the owner or an
  /// agent reads it; the model keeps its old name so no table is renamed.
  goalLinks GoalIdea[]

  @@index([projectId])
  @@map("notes")
}

/// Server-side preferences the app can change (F14): today one row, the model
/// that parses dictation.
///
/// A key/value table rather than a column somewhere, because there is no row
/// for a preference to live on -- one user, no users table -- and a one-row
/// table with a column per setting would need a migration for every new one.
///
/// Secrets do not belong here. The model's API key stays in `.env`, where only
/// root can read it; what the app may change is which model the key is spent
/// on, and a leaked model name costs nothing.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// One press of "Разобрать" (F14): what went to the model, what came back, how
/// long it took -- and, once the task is saved, what the user kept.
///
/// WHY THIS IS KEPT
///
/// It is the dataset the prompt and the choice of model are worked on against.
/// A new model or a new prompt is tried by replaying these inputs and comparing
/// the answers with what was accepted, before anything changes for the phone.
/// So a row keeps everything a replay needs: the words, the zone and the moment
/// they were parsed at (the prompt's calendar -- "в пятницу" -- depends on
/// both), the model, and which version of the prompt was used.
///
/// Failures are kept too. A model that times out or answers something that is
/// not JSON is exactly the kind of thing a comparison between models has to
/// count.
///
/// WHAT "FINAL" MEANS
///
/// `final*` is a snapshot of the task as saved from the dictation screen, taken
/// when the task is created -- i.e. the model's proposal after the user's
/// corrections, which is the label a replay is scored against. The task itself
/// may be edited later; `taskId` points at it for that, and is set to null
/// rather than deleting the row when the task goes, because the pair "input,
/// accepted answer" stays useful after the task is gone.
///
/// The tidying kinds (F15) are labelled the same way, by whichever route saves
/// their answer (`src/domain/dictationLink.ts`): `task_tidy` with the task it
/// tidied and `finalTitle`/`finalDescription`; `note` with `noteId`,
/// `finalTitle` and `finalContent`; `sandbox` with the inbox item it stayed as
/// (`inboxItemId`, `finalContent`) or the task it was filed into.
model DictationParse {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// What the words were parsed into: `task`, `task_tidy`, `note` or `sandbox`
  /// (`PARSE_KINDS` in src/domain/parsePipeline.ts). Each kind has its own
  /// prompt and its own `promptVersion`; a replay compares rows of one kind.
  kind String @default("task")

  /// The words as sent -- after any correction on the screen, before the model.
  inputText   String
  /// IANA zone the dates were read in.
  timeZone    String
  /// The "now" the prompt's calendar was built from.
  requestedAt DateTime

  model         String
  /// `DICTATION_PROMPT_VERSION` in src/domain/dictation.ts at the time.
  promptVersion String
  /// How freely the model could reword (src/domain/aiLevels.ts); null for
  /// rows from before levels existed, which ran at today's default.
  level         Int?

  /// `ok` or `failed`.
  status     String
  /// The model's reply exactly as received, before any tidying. Null when no
  /// reply arrived at all.
  rawReply   String?
  /// What the client was sent, in the kind's shape -- for `task`,
  /// `{ title, description, remindDate, remindTime }`.
  result     Json?
  /// Why it failed, for `failed`. Never shown to the client.
  error      String?
  durationMs Int

  taskId           String?
  task             Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  finalTitle       String?
  finalDescription String?
  finalRemindAt    DateTime?
  linkedAt         DateTime?

  /// `note`: the note the answer was saved into.
  noteId       String?
  note         Note?      @relation(fields: [noteId], references: [id], onDelete: SetNull)
  /// `sandbox`: the line the answer was saved as, while it stays a line. Set
  /// to null when the line is filed or thrown away; `finalContent` stays.
  inboxItemId  String?
  inboxItem    InboxItem? @relation(fields: [inboxItemId], references: [id], onDelete: SetNull)
  /// The saved text of a kind with one body: a note's content, a sandbox line.
  finalContent String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([kind, createdAt])
  @@index([taskId])
  @@index([noteId])
  @@index([inboxItemId])
  @@map("dictation_parses")
}

/// The owner's list of models to parse with, in order, and how each has been
/// doing (14.10.2026). See src/domain/modelRoster.ts for the rules. Empty:
/// the one model of `.env` / the `dictation.model` setting, as before.
model LlmModel {
  id       String @id @default(cuid())
  /// Order in the list: 0 is the most preferred.
  position Int
  /// The model's name at its provider, as the API wants it.
  name     String
  /// What the app shows; the name when null.
  label    String?
  /// OpenAI-compatible base URL of the provider; `LLM_BASE_URL` when null.
  baseUrl  String?
  /// NAME of the env variable with the provider's key (never the key itself,
  /// which stays in `.env`); `LLM_API_KEY` when null. Must start with `LLM_`.
  apiKeyEnv String?
  /// Sampling temperature for this model; the server's default (0.1) when
  /// null. Providers differ: Inception accepts only 0.5-1 and quietly
  /// replaces anything else with 1.
  temperature Float?
  /// Switched off by the owner.
  enabled  Boolean @default(true)

  /// Switched off by its own failures, until the owner switches it back on.
  autoDisabledAt      DateTime?
  autoDisabledReason  String?
  consecutiveFailures Int       @default(0)
  failStreakStartedAt DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("llm_models")
}

/// A picture attached to a task (task editor, design/task-editor-spec.md §10).
///
/// The row is the metadata; the bytes are two files on the attachments volume
/// (`ATTACHMENTS_DIR`): `<userId>/<id>.<ext>` -- the original, with its
/// metadata stripped -- and `<userId>/<id>.thumb.webp`. Files are only ever
/// served by the API after an ownership check (src/routes/attachments.ts).
///
/// Rows go with their task (`Cascade`); the files they leave behind are removed
/// by src/scripts/sweepAttachments.ts, which runs daily.
model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Idempotency key of an upload from the phone's outbox, like `Task.createKey`:
  /// a replayed upload answers with the attachment it already made.
  uploadKey String
  /// image/png | image/jpeg | image/webp, decided from the bytes, never from
  /// what the client said.
  mime      String
  /// Of the stored original (after metadata was stripped).
  sizeBytes Int
  width     Int
  height    Int
  /// Of the stored original; also its ETag.
  sha256    String
  createdAt DateTime @default(now())

  @@unique([taskId, uploadKey])
  @@index([taskId, createdAt])
  @@map("task_attachments")
}

/// Cache of `GET /link-preview` answers (§10): the page title for a link card.
/// 30 days for a success, a day for a failure (`failed`), see
/// src/domain/linkPreview.ts. The key is the URL without its fragment.
model LinkPreview {
  url       String   @id
  title     String?
  siteName  String?
  failed    Boolean  @default(false)
  fetchedAt DateTime @default(now())

  @@map("link_previews")
}

/// How many link previews a user has had fetched on one UTC day: the limit is
/// like the AI one (`AiUsage`) but counted apart, 100 a day by default
/// (`LINK_PREVIEW_DAILY_LIMIT`). Cache hits are free.
///
/// No relation to `User` on purpose: a counter that is dead weight after a day
/// does not need a foreign key, and leaving `User` untouched keeps this
/// migration independent of the other changes to that model.
model LinkPreviewUsage {
  userId String
  day    String
  count  Int    @default(0)

  @@id([userId, day])
  @@map("link_preview_usage")
}
