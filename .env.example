DATABASE_URL="postgresql://postgres:password@localhost:5432/taskradar"

# --- Auth (single user, no users table) ---
# Real values live in .env, which is gitignored. This file holds placeholders only.

# The one and only login email.
AUTH_EMAIL="you@example.com"

# bcrypt hash (cost factor 12) of the password -- never the password itself.
# The plaintext belongs only in CREDENTIALS.local.md (gitignored).
AUTH_PASSWORD_HASH="$2b$12$replace-with-a-real-bcrypt-hash"

# Signing key for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-at-least-32-random-characters"

# Whether to set the `Secure` attribute on the session cookie.
# Keep false for local dev and LAN/plain-HTTP testing: a Secure cookie is only ever
# sent over HTTPS, so on plain HTTP the browser would silently stop sending it back
# and auth would break with no error. Set true only when served over real HTTPS.
COOKIE_SECURE=false

# --- Dictation parsing (F14, optional) ---
# Any OpenAI-compatible /chat/completions endpoint: DeepSeek, OpenRouter, Qwen,
# or a local Ollama / llama.cpp server. Leave all three unset to switch the
# feature off -- dictation then keeps the words exactly as recognised. Setting
# only some of them is refused at startup.
#   DeepSeek:   LLM_BASE_URL="https://api.deepseek.com/v1"   LLM_MODEL="deepseek-chat"
#   OpenRouter: LLM_BASE_URL="https://openrouter.ai/api/v1"  LLM_MODEL="<vendor>/<model>"
#   Ollama:     LLM_BASE_URL="http://<host>:11434/v1"        LLM_MODEL="qwen3:14b"  (no key)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_TIMEOUT_MS=12000
