<?xml version="1.0" encoding="utf-8"?>
<!--
  A goal step row (design/goals-ideas-spec.md, п. 10): crown chip, the step
  (or «Обсудить: …») with the goal and its progress under it, and the take
  button. The row opens the task; the button takes it into work.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="6dp">

    <LinearLayout
        android:id="@+id/widget_goal_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_goal_row"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_goal_chip" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_crown"
                android:tint="@color/widget_crown" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_goal_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/widget_goal_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_goal_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_goal_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_goal_take"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/widget_goal_take"
            android:scaleType="center"
            android:src="@drawable/ic_widget_take"
            android:tint="@color/widget_goal_ink" />

        <TextView
            android:id="@+id/widget_goal_in_work"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@string/widget_goal_in_work"
            android:textColor="@color/widget_goal_muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
